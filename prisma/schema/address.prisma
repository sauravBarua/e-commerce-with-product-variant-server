enum AddressType {
  SHIPPING
  BILLING
}

model Address {
  id         String      @id @default(uuid())
  userId     String
  type       AddressType @default(SHIPPING)
  street     String
  city       String
  state      String
  postalCode String
  country    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id])
  orders     Order[]

  @@index([userId])
  @@index([city])
  @@index([country])
  @@map("addresses")
}
